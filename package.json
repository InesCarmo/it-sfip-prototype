{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node ./scripts/run-with-env.mjs vinext dev",
    "build": "node ./scripts/run-with-env.mjs vinext build",
    "start": "node ./scripts/run-with-env.mjs vinext start",
    "verify:encoding": "node ./operations/verify/verify-encoding.mjs",
    "verify:canonical-model": "node ./operations/verify/verify-canonical-model.mjs",
    "verify:db": "node ./operations/verify/verify-db.mjs",
    "verify:pipeline": "node ./operations/verify/verify-pipeline.mjs",
    "verify:search": "node ./operations/verify/verify-search.mjs",
    "verify:scheduler": "node ./operations/verify/verify-scheduler.mjs",
    "verify:temporal-state": "node ./operations/verify/verify-temporal-state.mjs",
    "verify": "node ./scripts/run-verify.mjs",
    "test": "tsx ./tests/core-engine.test.ts && tsx ./tests/autonomy.test.ts && tsx ./tests/ai-workspace-assistant.test.ts && tsx ./tests/funding-tenders-pipeline.test.ts && tsx ./tests/pipeline-diagnostics.test.ts && tsx ./tests/persistence.test.ts && tsx ./tests/quality/encoding.test.ts && tsx ./tests/quality/legacy-names.test.ts && tsx ./tests/quality/canonical-model.test.ts && node ./scripts/run-with-env.mjs vinext build && node --test tests/rendered-html.test.mjs",
    "test:core": "tsx ./tests/core-engine.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "sync:data": "node scripts/sync-core-data.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

